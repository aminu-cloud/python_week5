# Parent Class
class Vehicle:
    def move(self):
        pass  # This will be overridden by child classes


# Child Classes
class Car(Vehicle):
    def move(self):
        print("🚗 The car is driving on the road!")


class Plane(Vehicle):
    def move(self):
        print("✈️ The plane is flying through the sky!")


class Ship(Vehicle):
    def move(self):
        print("🚢 The ship is sailing across the ocean!")


# Using Polymorphism
vehicles = [Car(), Plane(), Ship()]

for v in vehicles:
    v.move()   # Each object responds differently
